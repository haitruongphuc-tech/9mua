# Sao chép thành .env trên VPS và điền giá trị thật. KHÔNG commit file .env.

# --- Bắt buộc ---
APP_URL=https://9mua.com
POSTGRES_PASSWORD=doi-thanh-mat-khau-dai-ngau-nhien
# Token bí mật cho cron gọi /api/internal/* (openssl rand -hex 32)
INTERNAL_CRON_TOKEN=

# --- Tuỳ chọn ---
# Cổng app trên host (Nginx proxy vào đây), mặc định 3009
APP_PORT=3009
# Thư mục dữ liệu trên host (ảnh, video, ảnh CCCD), mặc định /srv/9mua
DATA_DIR=/srv/9mua

# --- Email Brevo (T6) ---
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="9MUA <no-reply@9mua.com>"

# --- PayOS thu tiền (T13) ---
PAYMENTS_DRIVER=payos
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# --- PayOS chi hộ (T25) — để trống thì chi trả chạy chế độ duyệt tay ---
PAYOS_PAYOUT_CLIENT_ID=
PAYOS_PAYOUT_API_KEY=
PAYOS_PAYOUT_CHECKSUM_KEY=

# --- Admin 2 lớp (T31): khoá mã hoá bí mật TOTP (openssl rand -hex 32) ---
APP_ENCRYPTION_KEY=
