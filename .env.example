# Sao chép thành .env trên VPS và điền giá trị thật. KHÔNG commit file .env.

# --- Bắt buộc ---
APP_URL=https://9mua.com
POSTGRES_PASSWORD=doi-thanh-mat-khau-dai-ngau-nhien
# Token bí mật cho cron gọi /api/internal/* (openssl rand -hex 32)
INTERNAL_CRON_TOKEN=

# --- Tuỳ chọn ---
# Cổng app trên host (Nginx proxy vào đây), mặc định 3009
APP_PORT=3009
# Thư mục dữ liệu trên host (ảnh, video, ảnh CCCD), mặc định /srv/9mua
DATA_DIR=/srv/9mua

# --- Email Brevo (T6). MAIL_DRIVER mặc định: smtp ở production, console ở dev ---
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="9MUA <no-reply@9mua.com>"

# --- PayOS thu tiền (T13) ---
PAYMENTS_DRIVER=payos
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# --- PayOS chi hộ (T25) — để trống thì chi trả chạy chế độ duyệt tay ---
PAYOS_PAYOUT_CLIENT_ID=
PAYOS_PAYOUT_API_KEY=
PAYOS_PAYOUT_CHECKSUM_KEY=

# --- Admin 2 lớp (T31): khoá mã hoá bí mật TOTP (openssl rand -hex 32) ---
APP_ENCRYPTION_KEY=

# --- Đăng nhập Google (SPEC-identity.md bổ sung 27/10). Để trống thì ẩn nút "Tiếp tục với Google" ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Đăng nhập Zalo, Facebook (SPEC-identity.md bổ sung 29/10). Để trống thì ẩn nút đó ---
ZALO_APP_ID=
ZALO_APP_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# --- AI Studio (SPEC-ai.md). Để trống khoá thì phần đó báo "Chưa bật", phần còn lại vẫn chạy ---
# Khoá Claude: console.anthropic.com → API Keys. Khoá Gemini: aistudio.google.com → Get API key.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Model mặc định: claude-haiku-5-5 (viết chữ, nhanh và rẻ) và gemini-2.5-flash-image (vẽ ảnh). Đổi model thì
# điền tên vào đây; giá ước tính của model lạ được tính theo mức cao để ngân sách không bị tính thiếu.
AI_TEXT_MODEL=
AI_IMAGE_MODEL=

# --- Live (SPEC-live.md): IP công khai của VPS cho MediaMTX (trình duyệt gửi/nhận hình qua cổng 8189 UDP/TCP) ---
LIVE_PUBLIC_IP=

# --- Kho video ngoài (SPEC-creator.md V5.1, công tắc "Kho video ngoài" trong /admin/cong-tac) ---
# Cloudflare R2: tạo bucket, tạo khoá API (quyền đọc/ghi bucket đó), gắn tên miền media.9mua.com cho bucket và
# bật CORS cho phép GET từ https://9mua.com (trình phát video dài cần). Vùng R2 là "auto".
# Để trống thì video vẫn lưu trên VPS như hiện nay.
STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=auto
STORAGE_S3_BUCKET=
STORAGE_S3_KEY=
STORAGE_S3_SECRET=
STORAGE_PUBLIC_URL=

# --- Phụ đề tự động (SPEC-creator.md V5.4, công tắc "Phụ đề tự động") ---
# OpenAI: platform.openai.com → API keys (nạp tiền trả trước). Để trống thì không bật được công tắc.
STT_PROVIDER=openai
OPENAI_API_KEY=
