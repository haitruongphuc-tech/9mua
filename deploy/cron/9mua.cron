# /etc/cron.d/9mua — các tác vụ định kỳ của 9mua.com (giờ VPS nên đặt Asia/Ho_Chi_Minh)
# Token đọc từ .env của ứng dụng. Các dòng được bật dần theo task trong tasks/todo.md.
SHELL=/bin/sh
APP=http://127.0.0.1:3009
ENVFILE=/opt/9mua/.env

# T15 — đối soát thanh toán PayOS mỗi 5 phút
*/5 * * * * root . $ENVFILE; curl -fsS -m 120 -H "X-Internal-Token: $INTERNAL_CRON_TOKEN" $APP/api/internal/payments/reconcile >/dev/null

# T17 — email nhắc gia hạn Kiot lúc 8:00 mỗi ngày
0 8 * * * root . $ENVFILE; curl -fsS -m 300 -H "X-Internal-Token: $INTERNAL_CRON_TOKEN" $APP/api/internal/billing/reminders >/dev/null

# T21 — vòng đời đơn hàng mỗi 5 phút (huỷ quá hạn trả, 48h, 10 ngày, 7 ngày)
*/5 * * * * root . $ENVFILE; curl -fsS -m 240 -H "X-Internal-Token: $INTERNAL_CRON_TOKEN" $APP/api/internal/orders/tick >/dev/null

# T25 — đồng bộ lệnh chi PayOS mỗi 2 phút (đang chuyển → đã chuyển / lỗi), kiểm quỹ chi
*/2 * * * * root . $ENVFILE; curl -fsS -m 110 -H "X-Internal-Token: $INTERNAL_CRON_TOKEN" $APP/api/internal/payouts/sync >/dev/null

# T25 — gửi cảnh báo CEO đã gộp mỗi 5 phút
*/5 * * * * root . $ENVFILE; curl -fsS -m 60 -H "X-Internal-Token: $INTERNAL_CRON_TOKEN" $APP/api/internal/alerts/flush >/dev/null
