// Schema dùng chung cho mọi module. Mỗi model ghi chú module sở hữu (xem CAPABILITY-MAP.md).

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── identity (SPEC-identity.md) ─────────────────────────────────────────────

enum Role {
  user
  admin
}

model User {
  id                  String               @id @default(cuid(2))
  phone               String?              @unique // dạng +84xxxxxxxxx
  email               String?              @unique // chữ thường
  googleSub           String?              @unique // mã tài khoản Google đã liên kết (SPEC-identity.md bổ sung 27/10)
  displayName         String
  passwordHash        String
  role                Role                 @default(user)
  mustChangePassword  Boolean              @default(false)
  lockedAt            DateTime?
  // Hồ sơ công khai (SPEC-social.md bổ sung 30/10, A2): để trống được, tài khoản cũ không đổi gì.
  avatarUrl           String?
  coverUrl            String?
  bio                 String?
  // @tên (SPEC-identity.md V5.1): tự đặt cho tài khoản cũ; đổi 30 ngày một lần, @tên cũ giữ 30 ngày để chuyển hướng.
  handle              String?              @unique
  // "Ai được nhắc tên tôi" (SPEC-social.md V5.4 mục 2): everyone | following | nobody.
  mentionPolicy       String               @default("everyone")
  // Loại thông báo người dùng đã tắt (SPEC-social.md V5.5). Mặc định bật hết.
  notifyOff           String[]             @default([])
  handleChangedAt     DateTime?
  previousHandle      String?              @unique
  previousHandleUntil DateTime?
  // Lịch sử đã xem (SPEC-creator.md V5.2): người dùng tắt được việc ghi lịch sử.
  historyOff          Boolean              @default(false)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  sessions            Session[]
  resetTokens         PasswordResetToken[]
  kiot                Kiot?
  cartItems           CartItem[]
  address             BuyerAddress?
  authIdentities      AuthIdentity[]
}

// Tài khoản Zalo/Facebook đã liên kết (SPEC-identity.md bổ sung 29/10). Google dùng cột googleSub có sẵn.
model AuthIdentity {
  provider  String // zalo | facebook
  subject   String // mã tài khoản bên Zalo/Facebook
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([provider, subject])
  @@unique([userId, provider])
}

// Mã 6 số gửi qua email (SPEC-identity.md bổ sung 29/10): đăng nhập/đăng ký, liên kết Google/Facebook, thêm email.
// Chỉ lưu mã đã băm HMAC; IP cũng băm.
model EmailOtp {
  id        String    @id @default(cuid(2))
  email     String
  purpose   String // login | link | add-email
  codeHash  String
  attempts  Int       @default(0)
  ipHash    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime

  @@index([email, createdAt])
  @@index([ipHash, createdAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid(2))
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

model Session {
  id        String   @id @default(cuid(2))
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique // SHA-256 của token, không bao giờ lưu token gốc
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// Lần đăng nhập sai, để khoá 15 phút sau 5 lần (theo định danh đã chuẩn hoá).
model LoginAttempt {
  id         String   @id @default(cuid(2))
  identifier String
  createdAt  DateTime @default(now())

  @@index([identifier, createdAt])
}

// ─── kiot (SPEC-kiot.md) ─────────────────────────────────────────────────────

model Kiot {
  id                    String              @id @default(cuid(2))
  ownerId               String              @unique // MVP: mỗi tài khoản 1 Kiot
  owner                 User                @relation(fields: [ownerId], references: [id])
  slug                  String              @unique // tenkiot.9mua.com — cố định sau lần kích hoạt đầu tiên
  name                  String
  description           String              @default("")
  contactPhone          String // +84…, dùng cho nút gọi/Zalo
  logoUrl               String?
  coverUrl              String?
  province              String?
  district              String?
  addressLine           String?
  // Trạng thái active/expired tính từ activeUntil (module billing gia hạn); null = nháp
  activeUntil           DateTime?
  lockedAt              DateTime?
  lockReason            String?
  shippingFee           Int                 @default(0) // phí ship cố định mỗi đơn (0–200.000đ)
  freeShippingThreshold Int? // tiền hàng từ mức này trở lên thì miễn phí ship
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  products              Product[]
  images                ProductImage[]
  payoutAccounts        KiotPayoutAccount[]
  subscriptions         KiotSubscription[]
  orders                Order[]
}

// Lịch sử tài khoản nhận tiền: mỗi lần đổi thêm 1 dòng, bản mới nhất là bản đang dùng.
// payouts dùng changedAt (= createdAt dòng mới nhất) để tạm giữ tiền sau khi đổi tài khoản.
model KiotPayoutAccount {
  id            String   @id @default(cuid(2))
  kiotId        String
  kiot          Kiot     @relation(fields: [kiotId], references: [id])
  bankBin       String
  accountNumber String
  accountName   String // VIẾT HOA KHÔNG DẤU
  createdById   String
  createdAt     DateTime @default(now())

  @@index([kiotId, createdAt])
}

model Product {
  id              String         @id @default(cuid(2))
  kiotId          String
  kiot            Kiot           @relation(fields: [kiotId], references: [id])
  name            String
  // Tên đã bỏ dấu, chữ thường cho tìm kiếm. Trigger DB tự điền từ name — không ghi tay.
  searchName      String         @default("")
  description     String         @default("")
  price           Int // VNĐ
  compareAtPrice  Int? // giá gốc gạch ngang
  stock           Int            @default(0) // CHECK (stock >= 0) trong migration
  category        String
  visible         Boolean        @default(true) // người bán ẩn/hiện
  hiddenByAdminAt DateTime? // CEO gỡ vì vi phạm
  hiddenReason    String?
  deletedAt       DateTime? // xoá mềm: đơn cũ vẫn tham chiếu
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  images          ProductImage[]
  cartItems       CartItem[]

  @@index([kiotId, deletedAt])
  // Khai báo ở đây để Prisma không tự xoá chỉ mục tìm kiếm khi sinh migration.
  @@index([searchName(ops: raw("gin_trgm_ops"))], type: Gin, map: "Product_searchName_trgm")
}

// Ảnh tải lên trước (productId = null) rồi mới gắn vào sản phẩm khi lưu.
model ProductImage {
  id        String   @id @default(cuid(2))
  kiotId    String
  kiot      Kiot     @relation(fields: [kiotId], references: [id])
  productId String?
  product   Product? @relation(fields: [productId], references: [id])
  url       String
  thumbUrl  String
  width     Int
  height    Int
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId, position])
  @@index([kiotId, productId])
}

// ─── payments (SPEC-payments.md) ─────────────────────────────────────────────

enum PaymentStatus {
  pending
  paid
  expired
  cancelled
  mismatch
}

model PaymentIntent {
  id            String        @id @default(cuid(2))
  orderCode     BigInt        @unique // từ sequence payment_order_code_seq
  purpose       String // kiot_fee | order
  refId         String
  amount        Int
  description   String
  status        PaymentStatus @default(pending)
  paymentLinkId String?
  checkoutUrl   String
  qrCode        String
  expiresAt     DateTime
  paidAt        DateTime?
  amountPaid    Int?
  lastCheckedAt DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([purpose, refId, status])
  @@index([status, createdAt])
}

// Sổ cái tiền vào: chỉ thêm, không sửa, không xoá.
model PaymentEvent {
  id                     String   @id @default(cuid(2))
  orderCode              BigInt
  reference              String // mã giao dịch ngân hàng
  amount                 Int
  outcome                String // applied | partial | mismatch | duplicate_payment | orphan
  source                 String // webhook | reconcile
  transactionDateTime    String
  counterAccountName     String?
  counterAccountNumber   String?
  counterAccountBankName String?
  payload                Json
  createdAt              DateTime @default(now())

  @@unique([orderCode, reference])
  @@index([outcome])
}

// Trạng thái link của driver PayOS giả (dev/test/E2E); không dùng khi chạy PayOS thật.
model FakePayosLink {
  orderCode    BigInt   @id
  amount       Int
  description  String
  status       String
  expiresAt    DateTime
  transactions Json     @default("[]")
}

// ─── cài đặt dùng chung (phí thuê, phí sàn, hạn mức chi…) ────────────────────

model Setting {
  key         String   @id
  value       String
  updatedById String?
  updatedAt   DateTime @updatedAt
}

// ─── billing (SPEC-billing.md) ───────────────────────────────────────────────

model KiotSubscription {
  id          String   @id @default(cuid(2))
  kiotId      String
  kiot        Kiot     @relation(fields: [kiotId], references: [id])
  source      String // payos | admin_grant | voucher
  intentId    String?  @unique // 1 thanh toán = đúng 1 kỳ, chống cộng trùng
  amount      Int
  periodStart DateTime
  periodEnd   DateTime
  grantedById String?
  note        String?
  createdAt   DateTime @default(now())

  @@index([kiotId, createdAt])
}

// Mỗi mốc nhắc gia hạn chỉ gửi 1 lần cho mỗi kỳ hạn (cron chạy lại cũng không gửi trùng).
model BillingReminder {
  kiotId    String
  milestone String // d14 | d3 | d0
  periodEnd DateTime
  sentAt    DateTime @default(now())

  @@id([kiotId, milestone, periodEnd])
}

// ─── orders (SPEC-orders.md) ─────────────────────────────────────────────────

model CartItem {
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId     String
  product       Product  @relation(fields: [productId], references: [id])
  qty           Int
  sourceVideoId String? // món được thêm từ video Creator nào
  sourceLiveId  String? // món được thêm từ buổi live nào (SPEC-live.md)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@id([userId, productId])
}

enum OrderStatus {
  pending_payment
  paid
  confirmed
  shipping
  delivered
  completed
  cancelled
  refund_pending
  refunded
  disputed
}

// Địa chỉ nhận hàng mặc định của người mua.
model BuyerAddress {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  phone     String
  province  String
  district  String
  ward      String
  line      String
  updatedAt DateTime @updatedAt
}

// Một lần thanh toán (1 QR) cho các đơn của nhiều Kiot.
model Checkout {
  id        String   @id @default(cuid(2))
  buyerId   String
  total     Int
  intentId  String?
  status    String   @default("pending") // pending | paid | cancelled
  createdAt DateTime @default(now())
  orders    Order[]

  @@index([buyerId, createdAt])
}

model Order {
  id              String       @id @default(cuid(2))
  code            String       @unique // DH + số, dễ đọc qua điện thoại
  checkoutId      String
  checkout        Checkout     @relation(fields: [checkoutId], references: [id])
  kiotId          String
  kiot            Kiot         @relation(fields: [kiotId], references: [id])
  buyerId         String
  status          OrderStatus  @default(pending_payment)
  subtotal        Int
  shippingFee     Int
  total           Int
  platformFeeRate Int // basis point lúc đặt hàng: 500 = 5%
  shipTo          Json
  note            String?
  trackingCode    String?
  carrier         String?
  paidAt          DateTime?
  confirmedAt     DateTime?
  shippedAt       DateTime?
  deliveredAt     DateTime?
  completedAt     DateTime?
  cancelledAt     DateTime?
  refundAccount   Json?
  refundRef       String?
  refundedAt      DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  items           OrderItem[]
  events          OrderEvent[]
  dispute         Dispute?

  @@index([kiotId, status])
  @@index([buyerId, createdAt])
  @@index([status, updatedAt])
}

// Ảnh chụp sản phẩm lúc mua: không bao giờ sửa sau khi tạo.
model OrderItem {
  id            String  @id @default(cuid(2))
  orderId       String
  order         Order   @relation(fields: [orderId], references: [id])
  productId     String
  name          String
  price         Int
  qty           Int
  imageUrl      String?
  sourceVideoId String?
  sourceLiveId  String?

  @@index([productId])
  @@index([sourceVideoId])
  @@index([sourceLiveId])
}

// Lịch sử chuyển trạng thái: ai, lúc nào, từ đâu sang đâu, vì sao. Chỉ thêm.
model OrderEvent {
  id        String   @id @default(cuid(2))
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])
  from      String?
  to        String
  action    String
  actorId   String?
  actorRole String // buyer | seller | admin | system
  reason    String?
  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
}

model Dispute {
  id           String    @id @default(cuid(2))
  orderId      String    @unique
  order        Order     @relation(fields: [orderId], references: [id])
  message      String
  images       Json      @default("[]") // URL ảnh trong /uploads/disputes/<userId>/
  resolution   String? // refund | release
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime  @default(now())
}

// ─── payouts (SPEC-payouts.md) ───────────────────────────────────────────────

// Sổ số dư người bán: chỉ thêm. Số dư = SUM(amount), không lưu cứng ở đâu khác.
model BalanceEntry {
  id        String   @id @default(cuid(2))
  kiotId    String
  type      String // order_credit | payout_reserve | payout_reversal | adjustment
  amount    Int // có dấu: + cộng, − trừ
  refId     String // orderId | payoutId | id điều chỉnh
  note      String?
  actorId   String?
  createdAt DateTime @default(now())

  @@unique([type, refId])
  @@index([kiotId, createdAt])
}

// Phí sàn 9MUA thu trên mỗi đơn hoàn tất.
model PlatformRevenue {
  orderId   String   @id
  kiotId    String
  fee       Int
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Xác minh danh tính người bán trước lần rút tiền đầu tiên. Ảnh nằm trong PRIVATE_DIR (không công khai).
model KycSubmission {
  id           String    @id @default(cuid(2))
  userId       String
  fullName     String // VIẾT HOA KHÔNG DẤU như trên CCCD
  idNumber     String // 12 số
  frontImage   String // đường dẫn tương đối trong PRIVATE_DIR
  backImage    String
  status       String    @default("pending") // pending | approved | rejected
  reason       String?
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model PayoutRequest {
  id                   String    @id @default(cuid(2))
  code                 String    @unique // RT + số
  kiotId               String
  requestedById        String
  amount               Int // số tiền rút (trừ khỏi số dư)
  fee                  Int // phí chi hộ người bán chịu, chụp lúc tạo
  netAmount            Int // số tiền chuyển = amount − fee
  bankBin              String // chụp tài khoản nhận lúc tạo
  accountNumber        String
  accountName          String
  status               String    @default("pending") // pending | processing | paid | failed | rejected | cancelled
  mode                 String? // auto | manual
  autoRuleReasons      Json      @default("[]") // lý do không được chi tự động
  payosPayoutId        String?
  payosState           String?
  bankRef              String?
  receiverNameFromBank String?
  rejectReason         String?
  processedById        String?
  processedAt          DateTime?
  dispatchedAt         DateTime? // lúc chuyển sang processing (gửi lệnh chi PayOS)
  stuckAlertedAt       DateTime? // đã báo CEO lệnh treo (ON_HOLD / quá 2 giờ)
  payosAttempt         Int       @default(0) // tăng khi PayOS xác nhận KHÔNG tạo lệnh, để gửi lại bằng khoá mới
  paidAt               DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([kiotId, createdAt])
  @@index([status, createdAt])
}

// Cảnh báo gửi CEO (SPEC-admin.md mục 6): mỗi loại tối đa 1 email / 15 phút, gộp các sự việc chờ gửi.
model AlertEvent {
  id        String    @id @default(cuid(2))
  kind      String
  message   String
  createdAt DateTime  @default(now())
  sentAt    DateTime?

  @@index([kind, sentAt])
}

model AlertThrottle {
  kind       String   @id
  lastSentAt DateTime
}

// Chợ (SPEC-marketplace.md). Mỗi dòng: một sản phẩm trong một đơn đã hoàn tất, ghi từ hook
// orders.onOrderCompleted. Chỉ thêm. Là nguồn để tính "Bán chạy 30 ngày" và "Kiot nổi bật".
model ProductSale {
  orderId     String
  productId   String
  kiotId      String
  qty         Int
  completedAt DateTime

  @@id([orderId, productId])
  @@index([completedAt])
  @@index([kiotId, completedAt])
}

// Bảng tổng hợp để Chợ không phải đếm lại đơn mỗi lần mở trang.
model ProductSalesStat {
  productId String   @id
  sold30d   Int      @default(0)
  soldTotal Int      @default(0)
  updatedAt DateTime @updatedAt

  @@index([sold30d])
}

// Báo cáo vi phạm sản phẩm (SPEC-marketplace.md mục 6). Mỗi người chỉ báo 1 lần cho mỗi sản phẩm.
model ProductReport {
  id           String    @id @default(cuid(2))
  productId    String
  reporterId   String
  reason       String // hang_gia | cam_ban | lua_dao | khac
  message      String    @default("")
  status       String    @default("open") // open | dismissed | actioned
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@unique([productId, reporterId])
  @@index([status, createdAt])
}

// ===== Creator video (SPEC-creator.md) =====
model Video {
  id               String           @id @default(cuid(2))
  authorId         String
  caption          String           @default("")
  hashtags         String[]
  status           String           @default("processing") // processing | ready | failed | hidden | removed | deleted
  failReason       String?
  moderationNote   String? // lý do tự ẩn / CEO gỡ
  durationSec      Float?
  width            Int?
  height           Int?
  fileUrl          String?
  posterUrl        String?
  views            Int              @default(0)
  qualifiedViews   Int              @default(0) // xem ≥ 50% thời lượng
  likes            Int              @default(0)
  score            Float            @default(0)
  readyAt          DateTime?
  // Story 24 giờ và Duet (SPEC-creator.md bổ sung 27/10). Video cũ: kind = video, không hết hạn, không Duet.
  kind             String           @default("video") // video | story
  expiresAt        DateTime?
  duetOfId         String?
  // Quyền riêng tư từng video (SPEC-creator.md V5.3): public | followers | private. Video cũ là public.
  visibility       String           @default("public")
  allowComments    Boolean          @default(true)
  allowRemix       Boolean          @default(true) // Duet, Stitch, dùng âm thanh
  allowDownload    Boolean          @default(true)
  // Tuỳ chọn khi đăng và sau khi đăng (SPEC-creator.md V5.3). status thêm: draft (nháp) | scheduled (hẹn giờ).
  draft            Boolean          @default(false) // người đăng bấm "Lưu nháp": xử lý xong thì thành draft
  publishAt        DateTime? // giờ hẹn đăng
  draftWarnedAt    DateTime? // đã báo "nháp sắp tự xoá"
  province         String? // slug tỉnh/thành (34 tỉnh), không lưu toạ độ
  placeName        String? // tên địa điểm tự gõ ≤ 60 ký tự
  profilePinnedAt  DateTime? // ghim lên đầu trang cá nhân (tối đa 3)
  aiGenerated      Boolean          @default(false) // chip "Nội dung tạo bằng AI"
  aiStudio         Boolean          @default(false) // làm từ AI Studio: nhãn AI không gỡ được
  editedAt         DateTime? // sửa chữ, sản phẩm, địa điểm sau khi đăng → "Đã chỉnh sửa"
  sourceSec        Float? // thời lượng file gốc đo bằng ffprobe khi tạo (SPEC-creator.md V5.1): tính 120 phút video dài/ngày
  // Nhiều mức chất lượng (SPEC-creator.md V5.1): 3 ảnh bìa gợi ý (10%, 50%, 90%), ảnh xem trước WebP động 3 giây.
  posterChoices    String[]         @default([])
  previewUrl       String?
  // Phụ đề tự động (SPEC-creator.md V5.4): người đăng bật khi đăng.
  wantCaptions     Boolean          @default(false)
  // Bộ lọc màu và làm đẹp 0–3 (SPEC-creator.md V5.5), máy chủ áp khi xử lý.
  look             String?
  beauty           Int              @default(0)
  // Stitch (SPEC-creator.md V5.5 mục 4): đoạn 1–5 giây của video gốc ghép vào đầu video mới.
  stitchOfId       String?
  stitchFromSec    Float?
  stitchToSec      Float?
  // Chỉnh video trước khi đăng (SPEC-creator.md V5.6 mục 1): cắt đầu/cuối, chữ, nhãn dán; máy chủ dựng một lần.
  editSpec         Json?
  // Nhạc nền (SPEC-creator.md V5.6 mục 2): trộn vào file khi xử lý; giây bắt đầu, âm lượng nhạc và tiếng gốc 0–100.
  soundId          String?
  sound            Sound?           @relation(fields: [soundId], references: [id])
  soundStartSec    Float?
  soundVolume      Int?
  originalVolume   Int?
  // Watch (SPEC-creator.md V5.9): tập số episodeNo (1–200) của phim seriesId; watchOnly = "Chỉ hiện trong Watch".
  seriesId         String?
  episodeNo        Int?
  watchOnly        Boolean          @default(false)
  // Trả lời bình luận bằng video (SPEC-creator.md V5.8): thẻ bình luận hiện trên video ở toạ độ 0–1 người đăng kéo đặt.
  replyToCommentId String?
  replyCardX       Float?
  replyCardY       Float?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  products         VideoProduct[]
  renditions       VideoRendition[]
  captions         VideoCaption?

  @@index([status, score])
  @@index([status, readyAt])
  @@index([authorId, createdAt])
  @@index([kind, status, expiresAt])
  @@index([status, publishAt])
  @@index([soundId, status, readyAt])
  @@index([seriesId, episodeNo])
}

// Bài đăng ảnh + chữ (SPEC-creator.md V5.10). status: draft | scheduled | ready | removed | deleted.
// Bình luận, lưu, báo cáo, cảm xúc của bài nằm ở bảng riêng (PostComment, SavedPost, PostReport, Reaction): luật đợt này
// chỉ thêm bảng/cột, không đổi cột videoId đang bắt buộc của Comment, SavedVideo, VideoReport.
model Post {
  id             String        @id @default(cuid(2))
  authorId       String
  text           String        @default("")
  bgColor        String? // bài chỉ có chữ ≤ 300 ký tự: 1 trong 6 nền màu
  hashtags       String[]
  visibility     String        @default("public") // public | followers | private
  allowComments  Boolean       @default(true)
  soundId        String? // nhạc nền (V5.6)
  status         String        @default("ready")
  publishAt      DateTime?
  likes          Int           @default(0)
  editedAt       DateTime?
  moderationNote String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @default(now())
  images         PostImage[]
  products       PostProduct[]

  @@index([status, createdAt])
  @@index([authorId, createdAt])
}

model PostImage {
  id       String @id @default(cuid(2))
  postId   String
  post     Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  position Int
  url      String
  thumbUrl String
  width    Int
  height   Int

  @@index([postId, position])
}

model PostProduct {
  postId    String
  post      Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  productId String
  position  Int

  @@id([postId, productId])
}

// Ảnh tải lên trước khi đăng bài (giữ 24 giờ nếu không dùng).
model PostUpload {
  id        String   @id @default(cuid(2))
  ownerId   String
  url       String
  thumbUrl  String
  width     Int
  height    Int
  createdAt DateTime @default(now())

  @@index([ownerId, createdAt])
}

model PostComment {
  id        String    @id @default(cuid(2))
  postId    String
  userId    String
  parentId  String?
  text      String
  hiddenAt  DateTime?
  createdAt DateTime  @default(now())

  @@index([postId, createdAt])
  @@index([userId, createdAt])
}

model SavedPost {
  userId    String
  postId    String
  createdAt DateTime @default(now())

  @@id([userId, postId])
}

model PostReport {
  id        String   @id @default(cuid(2))
  postId    String
  userId    String
  reason    String
  message   String   @default("")
  status    String   @default("open") // open | dismissed | actioned
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([status, createdAt])
}

// Đếm số lần làm một việc trong cửa sổ 1 phút (vd. tim bình luận tối đa 60 lần mỗi phút), không phụ thuộc bấm rồi bỏ.
model RateWindow {
  key         String   @id // "<việc>:<userId>"
  windowStart DateTime
  count       Int      @default(0)
}

// Tim bình luận (SPEC-social.md V5.4 mục 1).
model CommentLike {
  commentId String
  userId    String
  createdAt DateTime @default(now())

  @@id([commentId, userId])
  @@index([userId, createdAt])
}

// Nhắc tên @ (SPEC-social.md V5.4 mục 2). sourceType: comment | video | post | post_comment.
model Mention {
  id         String   @id @default(cuid(2))
  sourceType String
  sourceId   String
  userId     String
  byUserId   String
  createdAt  DateTime @default(now())

  @@unique([sourceType, sourceId, userId])
  @@index([userId, createdAt])
}

// Từ cấm (SPEC-social.md V5.4 mục 3): folded = bỏ dấu, chữ thường để so khớp nguyên từ.
model MutedKeyword {
  id        String   @id @default(cuid(2))
  userId    String
  word      String
  folded    String
  createdAt DateTime @default(now())

  @@unique([userId, folded])
}

// Cảm xúc trên bài viết (SPEC-social.md V5.8): mỗi người một cảm xúc mỗi bài.
model Reaction {
  userId    String
  postId    String
  reaction  String   @default("like") // like | love | haha | wow | sad | angry
  createdAt DateTime @default(now())

  @@id([userId, postId])
  @@index([postId])
}

// Phim ngắn nhiều tập (SPEC-creator.md V5.9). Thể loại: tinh-cam | hai | gia-dinh | hanh-dong | khac.
model Series {
  id           String   @id @default(cuid(2))
  ownerId      String
  title        String
  description  String   @default("")
  coverPath    String? // ảnh bìa 2:3
  genre        String
  status       String   @default("ongoing") // ongoing (Đang ra) | complete (Đã đủ tập)
  episodeCount Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now())

  @@index([ownerId, updatedAt])
  @@index([updatedAt])
}

// "Lưu phim": có tập mới thì nhận thông báo.
model SeriesFollow {
  userId    String
  seriesId  String
  createdAt DateTime @default(now())

  @@id([userId, seriesId])
  @@index([seriesId])
}

// Tập và giây đang xem của người đã đăng nhập (khách lưu trong trình duyệt).
model SeriesProgress {
  userId    String
  seriesId  String
  videoId   String
  second    Int
  updatedAt DateTime @default(now())

  @@id([userId, seriesId])
}

// Tập đã xem (xem ≥ 90%).
model EpisodeWatched {
  userId    String
  videoId   String
  createdAt DateTime @default(now())

  @@id([userId, videoId])
}

// Bản tải về có logo 9MUA và @tên (SPEC-creator.md V5.7 mục 1): tạo ở lần tải đầu (việc nền), giữ 7 ngày rồi xoá file.
model VideoDownload {
  id        String    @id @default(cuid(2))
  videoId   String    @unique
  status    String    @default("queued") // queued | processing | ready | failed | expired
  path      String? // /uploads/downloads/….mp4
  attempts  Int       @default(0)
  error     String?
  lockedAt  DateTime?
  createdAt DateTime  @default(now())
  readyAt   DateTime?
  expiresAt DateTime?

  @@index([status, createdAt])
}

// Mỗi lượt tải về (tối đa 20 lượt mỗi người mỗi ngày).
model VideoDownloadLog {
  id        String   @id @default(cuid(2))
  userId    String
  videoId   String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// Âm thanh (SPEC-creator.md V5.6 mục 2): library = CEO tải lên ở /admin/am-thanh; original = tự tách từ video công khai
// cho phép dùng lại. Gỡ (removed) thì không chọn mới được; video đã dùng vẫn phát vì tiếng đã trộn vào file.
model Sound {
  id            String   @id @default(cuid(2))
  kind          String // library | original
  title         String? // trống: âm thanh gốc chưa đặt tên → "Âm thanh gốc – @tên"
  artist        String? // nguồn / nghệ sĩ của nhạc thư viện
  sourceVideoId String?  @unique
  path          String // /uploads/sounds/….m4a (AAC)
  durationSec   Float
  status        String   @default("active") // active | removed
  createdById   String? // CEO tải lên
  createdAt     DateTime @default(now())
  videos        Video[]

  @@index([status, kind])
}

model VideoProduct {
  videoId   String
  video     Video  @relation(fields: [videoId], references: [id])
  productId String
  position  Int

  @@id([videoId, productId])
}

// Hàng đợi chuyển mã: worker lấy việc bằng FOR UPDATE SKIP LOCKED.
model VideoJob {
  id         String    @id @default(cuid(2))
  videoId    String    @unique
  sourcePath String // file gốc trong PRIVATE_DIR, xoá sau khi xử lý
  status     String    @default("queued") // queued | running | done | failed
  attempts   Int       @default(0)
  lockedAt   DateTime?
  error      String?
  // Hàng chờ (SPEC-creator.md V5.1): worker luôn lấy việc short trước; việc long (video > 60 giây) mỗi lúc 1 việc.
  lane       String    @default("short")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([status, createdAt])
}

// Các bản của một video (SPEC-creator.md V5.1): MP4 720p + 480p cho video ≤ 60 giây; HLS 360p–1080p cho video dài
// (path là playlist của mức đó). Xoá video thì xoá hết file của mọi bản.
model VideoRendition {
  id        String   @id @default(cuid(2))
  videoId   String
  video     Video    @relation(fields: [videoId], references: [id])
  kind      String // mp4 | hls
  height    Int // cạnh ngắn: 360 | 480 | 720 | 1080
  path      String
  bytes     BigInt
  createdAt DateTime @default(now())

  @@unique([videoId, kind, height])
}

// Phụ đề tự động (SPEC-creator.md V5.4). Người đăng xem, sửa chữ rồi mới bật cho người xem (published).
model VideoCaption {
  videoId   String   @id
  video     Video    @relation(fields: [videoId], references: [id])
  status    String   @default("pending") // pending | running | ready | failed | skipped
  reason    String? // skipped: TOO_LONG | BUDGET; failed: lỗi từ dịch vụ
  vtt       String? // WebVTT
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
}

// Sổ chi phí phụ đề tự động (chỉ thêm, như AiUsage): ngân sách tháng stt_monthly_budget_vnd.
model SttUsage {
  id        String   @id @default(cuid(2))
  videoId   String
  userId    String
  provider  String
  seconds   Float
  costVnd   Int // VNĐ, làm tròn lên
  ok        Boolean
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Phiên tải video lên từng phần 8MB (SPEC-creator.md V5.1 mục 3). Phần lưu ở PRIVATE_DIR/video-chunks/<id>/, xoá sau
// khi ghép hoặc khi phiên quá 24 giờ. Mỗi người tối đa 3 phiên đang mở.
model VideoUploadSession {
  id          String   @id
  userId      String
  fileName    String
  size        BigInt
  durationSec Float? // đo ở trình duyệt; máy chủ đo lại bằng ffprobe khi tạo video
  partSize    Int
  parts       Int
  status      String   @default("open") // open | assembling | done | expired
  uploadId    String?
  createdAt   DateTime @default(now())
  expiresAt   DateTime

  @@index([userId, status])
  @@index([status, expiresAt])
}

model VideoLike {
  videoId   String
  userId    String
  createdAt DateTime @default(now())

  @@id([videoId, userId])
  @@index([userId])
}

// Mỗi người xem (tài khoản hoặc cookie ẩn danh) tính 1 lượt mỗi video mỗi ngày.
model VideoView {
  videoId   String
  viewerKey String // u:<userId> | a:<anonId>
  day       String // YYYY-MM-DD giờ Việt Nam
  qualified Boolean  @default(false)
  createdAt DateTime @default(now())

  @@id([videoId, viewerKey, day])
  @@index([viewerKey, createdAt])
}

model VideoReport {
  id        String   @id @default(cuid(2))
  videoId   String
  userId    String
  reason    String // noi_dung_xau | lua_dao | ban_quyen | khac
  message   String   @default("")
  status    String   @default("open") // open | dismissed | actioned
  createdAt DateTime @default(now())

  @@unique([videoId, userId])
  @@index([status, createdAt])
}

// Thông báo trong app (video xử lý xong, bị gỡ…).
model Notification {
  id        String    @id @default(cuid(2))
  userId    String
  title     String
  body      String    @default("")
  url       String?
  readAt    DateTime?
  // Thông báo mới (SPEC-social.md V5.5): loại (bật/tắt trong Cài đặt), khoá gộp theo giờ, số người đã gộp.
  kind      String?
  groupKey  String?
  count     Int       @default(1)
  createdAt DateTime  @default(now())

  @@index([userId, readAt, createdAt])
  @@index([userId, groupKey, createdAt])
}

// ===== Admin (SPEC-admin.md) =====
// Xác thực 2 lớp. Bí mật TOTP mã hoá bằng APP_ENCRYPTION_KEY; mã dự phòng lưu dạng băm.
model AdminTotp {
  userId       String    @id
  secretEnc    String
  backupHashes String[]
  lastTimeStep Int? // chống dùng lại mã vừa dùng
  enabledAt    DateTime? // null = đang cài, chưa xác nhận
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model AdminTotpAttempt {
  id        String   @id @default(cuid(2))
  userId    String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// Thiết bị admin đã nhập đúng mã 2 lớp và chọn "nhớ 30 ngày" (SPEC-admin.md bổ sung 27/10). Chỉ lưu mã băm của
// cookie; pwFingerprint đổi khi đổi mật khẩu nên thiết bị cũ tự hết hiệu lực.
model AdminTrustedDevice {
  id            String    @id @default(cuid(2))
  userId        String
  tokenHash     String    @unique
  pwFingerprint String
  userAgent     String
  createdAt     DateTime  @default(now())
  expiresAt     DateTime
  lastUsedAt    DateTime?
  revokedAt     DateTime?

  @@index([userId])
}

// Ghim của CEO (SPEC-admin.md bổ sung 27/10): video lên đầu "Dành cho bạn", Kiot lên đầu danh bạ / Kiot nổi bật.
model Pin {
  id          String    @id @default(cuid(2))
  kind        PinKind
  targetId    String
  position    Int
  until       DateTime?
  createdById String
  createdAt   DateTime  @default(now())

  @@unique([kind, targetId])
  @@index([kind, position])
}

enum PinKind {
  video
  kiot
}

// Phiên đăng nhập nào đã nhập mã 2 lớp, lúc nào (hết hạn sau 12 giờ).
model AdminSessionVerification {
  sessionId  String   @id
  userId     String
  verifiedAt DateTime
}

// Nhật ký thao tác admin: chỉ thêm, không sửa, không xoá.
model AdminAuditLog {
  id         String   @id @default(cuid(2))
  adminId    String
  action     String
  targetType String
  targetId   String
  reason     String?
  before     Json?
  after      Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([targetType, targetId])
}

// CEO ghi chú cách xử lý một khoản tiền vào bất thường (lệch số, không khớp đơn, trả 2 lần) và đánh dấu xong.
model PaymentIssueResolution {
  issueKey     String   @id // intent:<id> | event:<id>
  note         String
  resolvedById String
  resolvedAt   DateTime @default(now())
}

// ===== Social (SPEC-social.md) =====
model Follow {
  followerId String
  followeeId String
  createdAt  DateTime @default(now())

  @@id([followerId, followeeId])
  @@index([followeeId])
}

model Comment {
  id           String    @id @default(cuid(2))
  videoId      String
  userId       String
  parentId     String?
  text         String
  pinnedAt     DateTime?
  hiddenAt     DateTime?
  hiddenById   String?
  reportCount  Int       @default(0)
  atSecond     Int? // bình luận theo phút khi xem tập phim (SPEC-creator.md V5.9 mục 5)
  // Tim bình luận và ẩn theo từ cấm (SPEC-social.md V5.4): hiddenReason = keyword | owner | reports.
  likeCount    Int       @default(0)
  hiddenReason String?
  replyVideoId String? // video người đăng trả lời bình luận này (SPEC-creator.md V5.8)
  createdAt    DateTime  @default(now())

  @@index([videoId, createdAt])
  @@index([userId, createdAt])
  @@index([parentId])
}

model CommentReport {
  commentId String
  userId    String
  reason    String
  createdAt DateTime @default(now())

  @@id([commentId, userId])
}

model SavedVideo {
  userId    String
  videoId   String
  createdAt DateTime @default(now())

  @@id([userId, videoId])
}

model KiotHeart {
  kiotId    String
  userId    String
  createdAt DateTime @default(now())

  @@id([kiotId, userId])
}

// Lượt tim + follow mỗi ngày (giờ Việt Nam) của tài khoản Free.
model DailyAction {
  userId String
  day    String // YYYY-MM-DD theo Asia/Ho_Chi_Minh
  count  Int    @default(0)

  @@id([userId, day])
}

// Voucher mở Kiot khi đủ số video đã thả tim (mỗi tài khoản tối đa 1 voucher).
model KiotVoucher {
  id           String    @id @default(cuid(2))
  userId       String    @unique
  issuedAt     DateTime  @default(now())
  usedAt       DateTime?
  kiotId       String?
  revokedAt    DateTime?
  revokedById  String?
  revokeReason String?
}

// Link mạng xã hội người dùng tự dán (SPEC-kiot.md bổ sung 27/10).
model SocialLink {
  userId    String
  platform  String // tiktok | facebook | instagram | youtube | shopee | zalo
  url       String
  createdAt DateTime @default(now())

  @@id([userId, platform])
}

// ===== AI Studio (SPEC-ai.md) =====
// Mỗi lần gọi AI ghi 1 dòng chi phí ước tính (chỉ thêm, không sửa/xoá) — tính lượt trong ngày và ngân sách tháng.
model AiUsage {
  id           String   @id @default(cuid(2))
  userId       String
  kind         String // text | image
  model        String
  inputTokens  Int?
  outputTokens Int?
  images       Int?
  costVnd      Int // VNĐ, làm tròn lên
  ok           Boolean
  createdAt    DateTime @default(now())

  @@index([userId, kind, createdAt])
  @@index([createdAt])
}

// Ảnh AI vẽ, chưa phải ảnh sản phẩm: khi đăng bán mới chép sang ảnh sản phẩm. Ảnh quá 7 ngày tự xoá.
model AiImage {
  id        String   @id @default(cuid(2))
  userId    String
  url       String
  thumbUrl  String
  style     String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
}

// Video 10 giây ghép từ ảnh AI (worker chạy ffmpeg). Xem thử trước, bấm đăng bán mới lên feed.
model AiSlideshow {
  id        String    @id @default(cuid(2))
  userId    String
  imageIds  String[]
  status    String    @default("queued") // queued | running | done | failed
  url       String?
  error     String?
  attempts  Int       @default(0)
  lockedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

// Giá Kiot 1 USD/năm quy ra VNĐ theo tỷ giá bán USD của Vietcombank (SPEC-billing.md bổ sung 27/10). Mỗi lần lấy tỷ
// giá hoặc CEO đổi giá USD ghi 1 dòng (chỉ thêm): tỷ giá, giá cũ, giá mới, có áp dụng không.
model KiotFeeRateLog {
  id        String   @id @default(cuid(2))
  source    String // vietcombank | admin
  rate      Int // VNĐ cho 1 USD (giá bán)
  usdCents  Int
  oldFeeVnd Int
  newFeeVnd Int
  applied   Boolean
  note      String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ===== Live + xu (SPEC-live.md) =====
model LiveSession {
  id               String    @id @default(cuid(2))
  hostUserId       String
  kiotId           String? // Kiot của người phát (nếu có)
  title            String
  status           String    @default("created") // created | live | ended | stopped
  mediaPath        String    @unique // tên đường phát ngẫu nhiên trên MediaMTX
  publishTokenHash String
  publishExpiresAt DateTime // mã phát dùng một lần, hết hạn 2 phút nếu chưa dùng
  publishUsedAt    DateTime?
  pinnedProductId  String?
  startedAt        DateTime? // lúc MediaMTX báo có hình
  lastMediaAt      DateTime? // lần cuối thấy có hình
  endedAt          DateTime?
  endReason        String?
  peakViewers      Int       @default(0)
  hearts           Int       @default(0)
  hiddenAt         DateTime? // 5 báo cáo → ẩn khỏi danh sách
  createdAt        DateTime  @default(now())

  @@index([status, createdAt])
  @@index([hostUserId, createdAt])
}

model LiveViewer {
  liveId           String
  viewerKey        String // u:<userId> hoặc a:<mã khách ẩn danh>
  userId           String?
  networkHash      String // băm IP, không lưu IP gốc
  firstSeenAt      DateTime
  lastSeenAt       DateTime
  streakStartAt    DateTime // đầu chuỗi tín hiệu liên tục hiện tại
  longestStreakSec Int      @default(0)

  @@id([liveId, viewerKey])
  @@index([liveId, lastSeenAt])
}

// Mỗi người xem 1 dòng mỗi buổi: có kết nối được hình hay không (SPEC-live.md: tỉ lệ lỗi > 5% thì đề xuất TURN).
// Không phải sổ tiền: lần sau kết nối được thì sửa thành ok.
model LiveConnect {
  liveId    String
  viewerKey String
  ok        Boolean
  createdAt DateTime

  @@id([liveId, viewerKey])
  @@index([createdAt])
}

model LiveChatMessage {
  id        String    @id @default(cuid(2))
  liveId    String
  userId    String
  text      String
  hiddenAt  DateTime?
  hiddenBy  String?
  createdAt DateTime  @default(now())

  @@index([liveId, createdAt])
  @@index([createdAt])
}

model LiveChatBan {
  liveId    String
  userId    String
  createdAt DateTime @default(now())

  @@id([liveId, userId])
}

model LiveReport {
  liveId    String
  userId    String
  reason    String // bad_content | scam | copyright | other
  message   String?
  createdAt DateTime @default(now())

  @@id([liveId, userId])
}

model LiveBan {
  id        String    @id @default(cuid(2))
  userId    String
  until     DateTime? // trống = vĩnh viễn
  reason    String
  adminId   String
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

// Sổ xu (chỉ thêm, trigger chặn sửa/xoá). Dương là cộng, âm là trừ. Xu không phải tiền.
model XuEntry {
  id          String   @id @default(cuid(2))
  userId      String
  amount      Int
  kind        String // live_reward | admin_revoke
  liveId      String?
  rewardDay   String? // YYYY-MM-DD giờ VN, chỉ dòng thưởng: mỗi người tối đa 1 buổi được thưởng mỗi ngày
  note        String?
  createdById String?
  createdAt   DateTime @default(now())

  @@unique([userId, rewardDay])
  @@index([userId, createdAt])
  @@index([createdAt])
}

// Hộp thư (SPEC-messages.md, CEO duyệt 29/10). Trò chuyện 1-1: userAId < userBId (theo thứ tự chữ) để mỗi cặp 1 dòng.
model Conversation {
  id            String    @id @default(cuid(2))
  userAId       String
  userBId       String
  status        String // request (người lạ, chờ chấp nhận) | active
  requestedById String?
  acceptedAt    DateTime?
  lastMessageAt DateTime
  createdAt     DateTime

  @@unique([userAId, userBId])
  @@index([userBId])
}

model ConversationMember {
  conversationId String
  userId         String
  lastReadAt     DateTime?
  hiddenAt       DateTime? // "Xoá cuộc trò chuyện" chỉ ẩn phía người bấm; tin mới đến thì hiện lại

  @@id([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String    @id @default(cuid(2))
  conversationId String
  senderId       String
  text           String?
  imageId        String?
  productId      String?
  videoId        String? // thẻ video gửi từ bảng chia sẻ (SPEC-messages.md V5.1)
  createdAt      DateTime
  hiddenAt       DateTime? // CEO ẩn tin vi phạm
  hiddenReason   String?

  @@index([conversationId, createdAt])
  @@index([senderId, createdAt])
}

// Ảnh trong tin nhắn: file riêng tư (PRIVATE_DIR), chỉ thành viên cuộc trò chuyện (và CEO khi xem báo cáo) mở được.
model MessageImage {
  id        String   @id @default(cuid(2))
  ownerId   String
  fileKey   String
  width     Int
  height    Int
  createdAt DateTime

  @@index([ownerId, createdAt])
}

// Chặn trên toàn web (SPEC-social.md V5.3): một chiều là đủ để cả hai không thấy nhau. Chặn ở Hộp thư cũng ghi vào đây.
model UserBlock {
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  @@id([blockerId, blockedId])
  @@index([blockedId])
}

// Cam kết nội dung (SPEC-identity.md V5.6). lines = null nghĩa là 4 dòng mặc định (dịch 7 thứ tiếng); CEO sửa chữ thì tạo bản
// mới có lines riêng và mọi người được hỏi lại.
model CommitmentVersion {
  version       Int      @id
  lines         Json?
  publishedAt   DateTime @default(now())
  publishedById String?
}

// Sổ chỉ thêm: ai đồng ý bản nào, lúc nào, từ IP nào (chỉ admin xem).
model Commitment {
  id         String   @id @default(cuid(2))
  userId     String
  version    Int
  acceptedAt DateTime @default(now())
  ip         String?
  userAgent  String?

  @@unique([userId, version])
  @@index([userId])
}

// "Không quan tâm" (SPEC-creator.md V5.2): ẩn video, 30 ngày hạ điểm video cùng người đăng với người xem đó. Mỗi người
// tối đa 500 dòng (dòng cũ nhất tự xoá). viewerKey giống lượt xem: "u:<userId>" hoặc "a:<mã ẩn danh>".
model VideoNotInterested {
  viewerKey String
  videoId   String
  authorId  String
  createdAt DateTime @default(now())

  @@id([viewerKey, videoId])
  @@index([viewerKey, authorId, createdAt])
}

// Lịch sử đã xem (SPEC-creator.md V5.2): video xem ≥ 3 giây, giữ 90 ngày. Xoá lịch sử không đổi số lượt xem.
model ViewHistory {
  userId       String
  videoId      String
  lastViewedAt DateTime

  @@id([userId, videoId])
  @@index([userId, lastViewedAt])
}

model MessageBlock {
  blockerId String
  blockedId String
  createdAt DateTime

  @@id([blockerId, blockedId])
  @@index([blockedId])
}

model MessageReport {
  id             String    @id @default(cuid(2))
  conversationId String
  reporterId     String
  reportedUserId String
  reason         String
  createdAt      DateTime
  handledAt      DateTime?

  @@unique([conversationId, reporterId])
  @@index([reportedUserId, createdAt])
  @@index([handledAt, createdAt])
}

model MessageBan {
  id        String    @id @default(cuid(2))
  userId    String
  until     DateTime? // trống = vĩnh viễn
  reason    String
  byAdminId String? // trống = hệ thống tự cấm (3 báo cáo trong 7 ngày)
  createdAt DateTime

  @@index([userId, createdAt])
}

// Đếm cuộc trò chuyện mới mỗi ngày (giờ Việt Nam) của tài khoản Free.
model NewConversationDaily {
  userId String
  day    String
  count  Int    @default(0)

  @@id([userId, day])
}
