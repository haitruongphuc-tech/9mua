// Schema dùng chung cho mọi module. Mỗi model ghi chú module sở hữu (xem CAPABILITY-MAP.md).

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── identity (SPEC-identity.md) ─────────────────────────────────────────────

enum Role {
  user
  admin
}

model User {
  id                 String    @id @default(cuid(2))
  phone              String?   @unique // dạng +84xxxxxxxxx
  email              String?   @unique // chữ thường
  displayName        String
  passwordHash       String
  role               Role      @default(user)
  mustChangePassword Boolean   @default(false)
  lockedAt           DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  sessions           Session[]
  resetTokens        PasswordResetToken[]
  kiot               Kiot?
}

model PasswordResetToken {
  id        String    @id @default(cuid(2))
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

model Session {
  id         String   @id @default(cuid(2))
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique // SHA-256 của token, không bao giờ lưu token gốc
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([userId])
}

// Lần đăng nhập sai, để khoá 15 phút sau 5 lần (theo định danh đã chuẩn hoá).
model LoginAttempt {
  id         String   @id @default(cuid(2))
  identifier String
  createdAt  DateTime @default(now())

  @@index([identifier, createdAt])
}

// ─── kiot (SPEC-kiot.md) ─────────────────────────────────────────────────────

model Kiot {
  id           String    @id @default(cuid(2))
  ownerId      String    @unique // MVP: mỗi tài khoản 1 Kiot
  owner        User      @relation(fields: [ownerId], references: [id])
  slug         String    @unique // tenkiot.9mua.com — cố định sau lần kích hoạt đầu tiên
  name         String
  description  String    @default("")
  contactPhone String // +84…, dùng cho nút gọi/Zalo
  logoUrl      String?
  coverUrl     String?
  province     String?
  district     String?
  addressLine  String?
  // Trạng thái active/expired tính từ activeUntil (module billing gia hạn); null = nháp
  activeUntil  DateTime?
  lockedAt     DateTime?
  lockReason   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}
